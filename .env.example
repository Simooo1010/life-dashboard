# ─── Authentication ────────────────────────────────────────────────────────────
DASHBOARD_MASTER_PASSWORD=your_strong_password_here
SESSION_PASSWORD=generate_a_very_long_random_string_here_at_least_32_chars

# ─── Supabase: Life Dashboard Project ─────────────────────────────────────────
DASHBOARD_SUPABASE_URL=https://your-dashboard-project.supabase.co
DASHBOARD_SUPABASE_ANON_KEY=your_dashboard_supabase_anon_key

# ─── Notion ────────────────────────────────────────────────────────────────────
NOTION_TOKEN=ntn_your_token_here

# ─── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Google Calendar (iCal) ───────────────────────────────────────────────────
GOOGLE_CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/your_email/private-xxx/basic.ics

# ─── Weather (Modica & ilMeteo.it) ───────────────────────────────────────────
WEATHER_LOCATION_NAME=Modica
WEATHER_LAT=36.8588
WEATHER_LON=14.7608
WEATHER_TIMEZONE=Europe/Rome
WEATHER_PROVIDER=ilmeteo

# Opzionali: solo se possiedi un feed/API commerciale di ilMeteo.it.
# Se lasciati vuoti, il provider usa automaticamente il modello europeo ad alta risoluzione senza chiavi.
ILMETEO_FEED_URL=
ILMETEO_API_KEY=

# ─── Persistence Mode ─────────────────────────────────────────────────────────
PERSISTENCE_MODE=supabase
DB_PATH=./data/dashboard.db

# ─── Personal Finance Tracker (read-only link) ────────────────────────────────
# The tracker has no API/MCP server of its own — it reads/writes straight to its
# Supabase project (PostgREST) with RLS scoped to auth.uid(). The dashboard
# connects to that SAME Supabase project directly, the way the tracker itself
# does, using a server-only service-role key (never exposed to the browser) so
# reads work regardless of RLS, plus an explicit user id so queries always
# resolve to the right person. Find these values in the tracker's own Supabase
# project settings (Project Settings → API) and in its .env — NOT in this
# dashboard's own Supabase project (DASHBOARD_SUPABASE_* above).
FINANCE_SUPABASE_URL=https://your-finance-tracker-project.supabase.co
FINANCE_SUPABASE_SERVICE_ROLE_KEY=your_finance_tracker_service_role_key
FINANCE_USER_ID=uuid_of_the_finance_tracker_user
# Optional: deployed URL of the tracker app, for a "open the tracker" link on
# the dedicated Finance page. Leave empty to hide the link.
FINANCE_APP_URL=
