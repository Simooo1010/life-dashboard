# ─── Authentication ────────────────────────────────────────────────────────────
DASHBOARD_MASTER_PASSWORD=your_strong_password_here
SESSION_PASSWORD=generate_a_very_long_random_string_here_at_least_32_chars

# ─── Supabase: Life Dashboard Project ─────────────────────────────────────────
DASHBOARD_SUPABASE_URL=https://your-dashboard-project.supabase.co
DASHBOARD_SUPABASE_ANON_KEY=your_dashboard_supabase_anon_key

# ─── Notion ────────────────────────────────────────────────────────────────────
NOTION_TOKEN=ntn_your_token_here

# ─── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Google Calendar (iCal) ───────────────────────────────────────────────────
GOOGLE_CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/your_email/private-xxx/basic.ics

# ─── Weather (ilMeteo.it & Location) ──────────────────────────────────────────
WEATHER_LOCATION_NAME=Modica
WEATHER_LAT=36.8588
WEATHER_LON=14.7608
WEATHER_TIMEZONE=Europe/Rome
WEATHER_PROVIDER=ilmeteo
ILMETEO_FEED_URL=
ILMETEO_API_KEY=

# ─── Persistence Mode ─────────────────────────────────────────────────────────
PERSISTENCE_MODE=supabase
DB_PATH=./data/dashboard.db
